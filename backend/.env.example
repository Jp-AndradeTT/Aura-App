# --- obrigatórios ---
# JWT_SECRET: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-por-um-valor-longo-e-aleatorio
# DATA_KEY (criptografia dos dados no banco): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# GUARDE UMA CÓPIA FORA DO SERVIDOR: sem esta chave os dados do banco não podem ser lidos.
DATA_KEY=
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5

# --- e-mail (ativação de conta e recuperação de senha) ---
# OPÇÃO A: Gmail da mentora (SMTP). Exige verificação em duas etapas no Google e uma "senha de app" (16 letras).
#   SMTP_HOST=smtp.gmail.com / SMTP_PORT=587 / SMTP_USER=email@gmail.com / SMTP_PASSWORD=senha-de-app
# OPÇÃO B: domínio próprio verificado no Resend (RESEND_API_KEY). Não funciona com @gmail.com/@outlook.com.
# Sem nenhum dos dois, em modo debug os links aparecem no console do servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
MAIL_FROM=Aura <email.da.mentora@gmail.com>
APP_URL=http://localhost:5173

# --- limites e rede ---
AI_EXTRACT_DAILY=10      # leituras de fatura por usuário a cada 24 h
AI_PLAN_DAILY=20         # planos com IA por usuário a cada 24 h
AI_CHAT_DAILY=30         # mensagens do chat com a Aura por usuário a cada 24 h
AI_GLOBAL_MONTHLY_LIMIT=1000  # teto de usos da IA (leitura + plano + chat) no app inteiro em 30 dias
# Modelos: CLAUDE_MODEL (plano), CLAUDE_MODEL_EXTRACT (leitura da fatura), CLAUDE_MODEL_CHAT (chat). Padrão: todos iguais.
# Para economizar, teste claude-haiku-5-5 na leitura e/ou no chat e compare a qualidade com faturas reais.
INVITE_CODE=             # opcional: se preenchido, só quem tem o código consegue criar conta
TRUSTED_PROXIES=1        # 1 = só Render; 2 = Cloudflare + Render (necessário para limitar por IP corretamente)
ADMIN_EMAILS=            # e-mail da mentora (o mesmo do cadastro dela), separado por vírgula se houver mais de um; vê só números agregados de uso, nunca dados financeiros de um mentorado
ALLOWED_ORIGINS=http://localhost:5173  # origens com permissão para chamar a API (separadas por vírgula); em produção, use o(s) domínio(s) reais do site (ex.: https://app.seudominio.com)

# --- local ---
COOKIE_SECURE=0          # use 1 em produção (HTTPS)
FLASK_DEBUG=1
# DATABASE_URL=postgresql://usuario:senha@host/aura   (local usa SQLite)
